  (text "J1 (JST PH, bus board pinout): 1=-12V  2=GND  3=+12V  4=GND  5=+5V (not used here)" (exclude_from_sim no) (at 25.4 25.4 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "67c6a30d-3b8a-4fb6-bcdb-9a081b5909a5")
  )
  (text "J2: female 2x5 socket on the BOTTOM face, mates with the module's 10-pin header. Doepfer numbering." (exclude_from_sim no) (at 25.4 29.21 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "8318dd7e-315c-4cb9-baaf-e8ad0539b5ac")
  )
  (text "J2 map: 1,2=-12V  3-8=GND  9,10=+12V" (exclude_from_sim no) (at 25.4 33.02 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "0f43b14a-32d8-403d-a97a-d85c70d9eae9")
  )
  (text "Rotation on a 10-pin header swaps +12V and -12V. No wiring can stop that, so the board" (exclude_from_sim no) (at 25.4 36.83 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "90f576d8-2969-45ed-a5ca-f92912fb7762")
  )
  (text "has an edge notch and a silk arrow at the -12V end. Match it to the red stripe." (exclude_from_sim no) (at 25.4 40.64 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "d92f5299-49f2-434c-b0b2-1c07a90d4a94")
  )
  (text "D1-D2: series Schottky on each rail, protects against a mis-crimped cable." (exclude_from_sim no) (at 25.4 44.45 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "549cfd73-c339-4d54-8c11-68937e73b336")
  )
