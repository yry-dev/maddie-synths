{
    "layout": {
        "type": "grid",
        "rows": 4,
        "cols": 3,
        "hspace": "2mm",
        "vspace": "2mm",
        "rotation": "0deg"
    },
    "tabs": {
        "type": "fixed",
        "width": "3mm",
        "hcount": 0,
        "vcount": 1
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.5mm",
        "spacing": "0.8mm",
        "offset": "0.2mm",
        "prolong": "0.5mm"
    },
    "framing": {
        "type": "railstb",
        "width": "5mm",
        "space": "2mm"
    },
    "tooling": {
        "type": "3hole",
        "hoffset": "3mm",
        "voffset": "2.5mm",
        "size": "1.152mm"
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "7mm",
        "voffset": "2.5mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "text": {
        "type": "simple",
        "text": "set by panelize.py",
        "anchor": "mt",
        "voffset": "2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.2mm",
        "height": "1.2mm",
        "thickness": "0.2mm"
    },
    "post": {
        "millradius": "1mm"
    }
}
