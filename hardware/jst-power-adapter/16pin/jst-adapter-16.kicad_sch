  (text "J1 (JST PH, bus board pinout): 1=-12V  2=GND  3=+12V  4=GND  5=+5V" (exclude_from_sim no) (at 25.4 25.4 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "754e9d8a-4f62-4b0c-b0c8-0ff616b726de")
  )
  (text "J2: female 2x8 socket on the BOTTOM face, mates with the module's 16-pin header. Doepfer numbering." (exclude_from_sim no) (at 25.4 29.21 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "1bf1d4ca-243f-4707-95b4-bfc1222079fe")
  )
  (text "J2 map: 1,2=-12V  3,4=GND  5-8=open  9,10=+12V  11,12=+5V  13-16=open (CV/Gate dropped)" (exclude_from_sim no) (at 25.4 33.02 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "f6294f9e-00c2-4eab-99bc-3468a1b7ca1c")
  )
  (text "Rotation guard: GND is only on 3/4. Rotated 180 deg, +12V/+5V land on module GND (8..5)," (exclude_from_sim no) (at 25.4 36.83 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "5a71555e-81f9-4cb1-872d-a9db50ca264a")
  )
  (text "adapter GND lands on CV (14,13), and the module rails land on open pins: no return path," (exclude_from_sim no) (at 25.4 40.64 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "5fd89c8c-46ca-46c9-8162-337aee20457d")
  )
  (text "so no current flows. D3 stops +12V back-feeding the +5V output through the module GND." (exclude_from_sim no) (at 25.4 44.45 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "1c924046-29f7-4c5a-ae38-5fd210fed1c5")
  )
  (text "D1-D3: series Schottky on every rail, protects against a mis-crimped cable." (exclude_from_sim no) (at 25.4 48.26 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid "f41481b4-924f-4c02-aeff-e1192da2a054")
  )
